# ─── Envío del formulario de contacto ───────────────────────────
# Opción A (recomendada): Resend — https://resend.com
RESEND_API_KEY=
# Email que recibe las solicitudes del formulario
CONTACT_TO_EMAIL=
# Remitente verificado en Resend (requiere verificar su dominio en Resend).
# Ejemplo: "Sitio web <formularios@sudominio.com>"
CONTACT_FROM_EMAIL=

# Opción B (alternativa): Formspree — https://formspree.io
# Se usa solo si RESEND_API_KEY está vacío. Pegue el ID del formulario (p. ej. "xyzabcd").
FORMSPREE_FORM_ID=
